# OpenAI-compatible chat endpoint.
# Example OpenAI endpoint: https://api.openai.com/v1/chat/completions
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=replace_me
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=1200

# Set to false if you do not want screenshots sent to the model.
ALLOW_SCREEN_ANALYSIS=true

# Automatically install the lab service on Windows startup.
AUTO_INSTALL_SERVICE=true
