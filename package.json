{
  "name": "windows-system-service-lab",
  "productName": "Windows System Service Lab",
  "private": true,
  "version": "1.0.0",
  "description": "Windows application identity, process and AI chatbot research lab.",
  "main": "electron/main.js",
  "author": "Research Lab",
  "license": "MIT",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "dev": "concurrently -k \"npm run dev:vite\" \"npm run dev:electron\"",
    "build": "vite build",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "install-service": "node scripts/install-service.js",
    "uninstall-service": "node scripts/uninstall-service.js"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "electron": "^34.3.3",
    "electron-builder": "^25.1.8",
    "vite": "^6.1.0",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.research.windows-system-service-lab",
    "productName": "Windows System Service Lab",
    "artifactName": "Windows-System-Service-Lab-${version}-${arch}.${ext}",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/**/*",
      "package.json",
      ".env.example",
      "scripts/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "WindowsSystemServiceLab",
      "publisherName": "Research Lab",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Windows System Service Lab",
      "deleteAppDataOnUninstall": false
    },
    "extraResources": [
      {
        "from": "scripts/install-lab-service.ps1",
        "to": "lab-service/install-lab-service.ps1"
      }
    ]
  }
}
